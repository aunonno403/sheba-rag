# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any LiteLLM model string works, e.g. gemini/gemini-3.5-flash (better, but only 20 free requests/day),
# anthropic/claude-sonnet-5-5, openai/gpt-5, ollama/llama3
LLM_MODEL=gemini/gemini-3.5-flash-lite
JUDGE_MODEL=gemini/gemini-3.1-flash-lite
EMBED_MODEL=BAAI/bge-m3
CHUNKER=sentence
TOP_K=5
# Only needed if tesseract is not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MIN_SCORE=0.40
